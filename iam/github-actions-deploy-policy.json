{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PushImagesToEcr",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrRepoAccess",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:ap-south-1:ACCOUNT_ID:repository/meera-bakery"
    },
    {
      "Sid": "SyncStaticSite",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:PutObject", "s3:DeleteObject", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::STATIC_BUCKET_NAME",
        "arn:aws:s3:::STATIC_BUCKET_NAME/*"
      ]
    }
  ]
}
