{
  "version": "2.0.0",
  "tasks": [
    { "label": "Run tests", "type": "shell", "command": "python -m pytest -v", "group": "test" },
    { "label": "Run API (dev)", "type": "shell", "command": "python -m uvicorn app.main:app --reload --port 8000" },
    { "label": "Terraform: init", "type": "shell", "command": "terraform init", "options": { "cwd": "${workspaceFolder}/terraform" } },
    { "label": "Terraform: plan", "type": "shell", "command": "terraform plan", "options": { "cwd": "${workspaceFolder}/terraform" } },
    { "label": "Docker: build", "type": "shell", "command": "docker build -t meera-bakery:local ." },
    { "label": "Docker: run", "type": "shell", "command": "docker run --rm -p 8000:8000 --env-file .env meera-bakery:local" }
  ]
}
