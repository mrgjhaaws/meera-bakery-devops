# Copy this file to ".env" and fill in your own values.
#   Windows PowerShell : Copy-Item .env.example .env
#   macOS / Linux      : cp .env.example .env
# NEVER commit ".env" to GitHub (it is already in .gitignore).

APP_ENV=dev
AWS_REGION=ap-south-1

# Option A (learning only): access keys for your IAM user (Lesson 8 and 10).
# Prefer IAM roles on EC2/ECS/Lambda - then you do not need these two lines at all.
AWS_ACCESS_KEY_ID=PASTE_YOUR_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=PASTE_YOUR_SECRET_ACCESS_KEY_HERE

# Bucket used by the bakery app to store product images (Lesson 10/13)
S3_BUCKET=meera-bakery-images-yourname-12345

# Lesson 11: set to true to read S3_BUCKET etc. from SSM Parameter Store
USE_PARAMETER_STORE=false
